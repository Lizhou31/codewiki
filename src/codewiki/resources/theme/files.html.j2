{% extends "_base.html.j2" %}
{% set page = 'files' %}
{% block title %}Source file index — {{ project.name }}{% endblock %}
{% block main %}
<div class="crumb">{{ project.name }}</div>
<h1>Source file index</h1>
<p>What you need to know before touching a file. This is the view an LLM
should be handed when it is about to edit code.</p>

{% for f, e in by_file | dictsort %}
<h2><code>{{ f }}</code></h2>
{% if e.owner_doc %}<p class="crumb">Owned by <a href="{{ e.owner_doc }}.html">{{ e.owner_doc }}</a></p>{% endif %}
{% if e.anchors %}
<table>
  <tr><th>Role</th><th>Anchor</th><th>Symbol</th><th>Lines</th></tr>
  {% for a in e.anchors %}
  <tr>
    <td><span class="role {{ a.role }}">{{ a.role }}</span></td>
    <td><a href="{{ a.url }}">{{ a.title }}</a></td>
    <td><code>{{ a.symbol or '—' }}</code></td>
    <td class="loc">{{ a.lines[0] }}–{{ a.lines[1] }}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}
{% if e.refs %}
<p class="crumb">Referenced as read-only by:
{% for r in e.refs %}<code>{{ r.symbol }}</code> → <a href="{{ r.doc }}.html">{{ r.doc }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>
{% endif %}
{% if not e.anchors and not e.refs %}<p class="crumb">No wiki coverage.</p>{% endif %}
{% endfor %}
{% endblock %}
