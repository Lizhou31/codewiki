<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% block title %}{{ project.name }}{% endblock %}</title>
<link rel="stylesheet" href="style.css">
<link rel="stylesheet" href="vendor/hljs-light.css" media="(prefers-color-scheme: light)">
<link rel="stylesheet" href="vendor/hljs-dark.css" media="(prefers-color-scheme: dark)">
</head>
<body>
<a class="skip-link" href="#content">Skip to content</a>
<header class="topbar">
  <a class="brand" href="index.html"><span class="brand-mark" aria-hidden="true">cw</span>{{ project.name }}</a>
  <span class="topbar-label">Code documentation</span>
  <nav aria-label="Main"><a href="index.html" {{ 'aria-current=page' if page == 'index' }}>Overview</a><a href="files.html" {{ 'aria-current=page' if page == 'files' }}>Source index</a></nav>
</header>
<div class="layout {{ 'has-toc' if doc is defined }} {{ 'architecture-layout' if doc is defined and doc.type == 'architecture' }}">
  <aside class="side">
    <details class="nav-panel" open>
      <summary>Browse documentation</summary>
      <div class="page-search" hidden>
        <label class="sr-only" for="page-search">Find a page</label>
        <input id="page-search" type="search" placeholder="Find a page…" autocomplete="off">
      </div>
      <div class="nav-actions" hidden>
        <button type="button" data-nav-expand="true">Expand all</button>
        <button type="button" data-nav-expand="false">Collapse all</button>
      </div>
      <nav class="project-nav" aria-label="Project documents">
        {% set active_ids = (ancestors | default([]) | map(attribute='id') | list) + ([doc.id] if doc is defined else []) %}
        {% macro page_link(d) -%}
        <a href="{{ d.out }}" class="{{ 'on' if doc is defined and d.id == doc.id }}" {% if doc is defined and d.id == doc.id %}aria-current="page"{% endif %}>{{ d.title }}</a>
        {%- endmacro %}
        <ul class="nav-tree">
          <li class="nav-item"><a href="index.html" class="{{ 'on' if page == 'index' }}" {% if page == 'index' %}aria-current="page"{% endif %}>Overview</a></li>
          {% for d in nav_tree recursive %}
          <li class="nav-item">
            {% if d.children %}
            <details class="nav-branch" data-page-id="{{ d.id }}" {% if d.id in active_ids %}open{% endif %}>
              <summary aria-label="Toggle pages under {{ d.title }}">{{ page_link(d) }}</summary>
              <ul>{{ loop(d.children) }}</ul>
            </details>
            {% else %}
            {{ page_link(d) }}
            {% endif %}
          </li>
          {% endfor %}
        </ul>
      </nav>
      <p class="search-empty" role="status" hidden>No matching pages.</p>
    </details>
    <div class="side-note">Choose a guide to get started.<br>Follow links for more detail.</div>
  </aside>
  <main id="content" tabindex="-1">
    {% block main %}{% endblock %}
    <footer><span>{{ project.name }} documentation</span><span>Built {{ generated[:10] }}</span></footer>
  </main>
  {% if doc is defined %}<aside class="page-toc" aria-label="On this page">{% block sidenav %}{% endblock %}</aside>{% endif %}
</div>
<script src="reading.js" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>
