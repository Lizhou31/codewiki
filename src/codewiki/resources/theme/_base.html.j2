<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% block title %}{{ project.name }}{% endblock %}</title>
<link rel="stylesheet" href="style.css">
<link rel="stylesheet" href="vendor/hljs-light.css" media="(prefers-color-scheme: light)">
<link rel="stylesheet" href="vendor/hljs-dark.css" media="(prefers-color-scheme: dark)">
</head>
<body>
<a class="skip-link" href="#content">Skip to content</a>
<header class="topbar">
  <a class="brand" href="index.html"><span class="brand-mark" aria-hidden="true">cw</span>{{ project.name }}</a>
  <span class="topbar-label">Code documentation</span>
  <nav aria-label="Main"><a href="index.html" {{ 'aria-current=page' if page == 'index' }}>Overview</a><a href="files.html" {{ 'aria-current=page' if page == 'files' }}>Source index</a></nav>
</header>
<div class="layout {{ 'has-toc' if doc is defined }} {{ 'architecture-layout' if doc is defined and doc.type == 'architecture' }}">
  <aside class="side">
    <details class="nav-panel" open>
      <summary>Browse documentation</summary>
      <div class="page-search" hidden>
        <label class="sr-only" for="page-search">Find a page</label>
        <input id="page-search" type="search" placeholder="Find a page…" autocomplete="off">
      </div>
      <nav class="project-nav" aria-label="Project documents">
        {% for d in nav %}
        <a href="{{ d.out }}" style="--depth: {{ d.depth }}" class="{{ 'on' if doc is defined and d.id == doc.id }}" {% if doc is defined and d.id == doc.id %}aria-current="page"{% endif %}>{{ d.title }}</a>
        {% endfor %}
      </nav>
      <p class="search-empty" role="status" hidden>No matching pages.</p>
    </details>
    <div class="side-note">Start with the architecture.<br>Follow a concept into the code.</div>
  </aside>
  <main id="content" tabindex="-1">
    {% block main %}{% endblock %}
    <footer><span>{{ project.name }} documentation</span><span>Built {{ generated[:10] }}</span></footer>
  </main>
  {% if doc is defined %}<aside class="page-toc" aria-label="On this page">{% block sidenav %}{% endblock %}</aside>{% endif %}
</div>
<script src="reading.js" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>
