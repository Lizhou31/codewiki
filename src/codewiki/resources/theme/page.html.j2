{% extends "_base.html.j2" %}
{% block title %}{{ doc.title }} — {{ project.name }}{% endblock %}

{% block sidenav %}
<p class="eyebrow">On this page</p>
<nav>
  {% for s in doc.outline %}
    <a href="#{{ s.slug }}" class="{{ 'sub' if s.level > 2 }}">{{ s.title }}</a>
  {% endfor %}
  {% if docs | selectattr('parent', 'equalto', doc.id) | list %}<a href="#explore-next">Explore next</a>{% endif %}
  {% if doc.owns or doc.refs %}<a href="#sec-code">Source references</a>{% endif %}
</nav>
<p class="toc-source">Page source<br><code>{{ doc.path }}</code></p>
{% endblock %}

{% block main %}
<nav class="breadcrumb" aria-label="Breadcrumb">
<a href="index.html">{{ project.name }}</a><span aria-hidden="true">/</span>
{% for ancestor in ancestors %}<a href="{{ ancestor.out }}">{{ ancestor.title }}</a><span aria-hidden="true">/</span>{% endfor %}
<span>{{ doc.type | capitalize }}</span>
</nav>
<header class="page-heading">
  {% set root = ancestors[0] if ancestors else doc %}
  {% if root.type == 'manual' %}
  <div class="reading-depth" aria-label="Reading path"><a href="{{ root.out }}">{{ root.title }}</a>{% for ancestor in ancestors[1:] %}<span>→</span><a href="{{ ancestor.out }}">{{ ancestor.title }}</a>{% endfor %}{% if doc.parent %}<span>→</span><span class="active">{{ doc.title }}</span>{% endif %}</div>
  {% else %}
  <div class="reading-depth" aria-label="Reading path"><a href="{{ ancestors[0].out if ancestors else doc.out }}">01 Architecture</a><span>→</span><span class="{{ 'active' if doc.parent }}">02 Component</span><span>→</span><span>03 Implementation</span></div>
  {% endif %}
  <div class="eyebrow">{{ doc.type }} guide <span class="status st-{{ doc.status }}">{{ doc.status }}</span></div>
  <h1>{{ doc.title }}</h1>
  {% if doc.summary %}<p class="lead">{{ doc.summary }}</p>{% endif %}
  {% if doc.related %}<div class="related">Related: {% for r in doc.related %}<a href="{{ r }}.html">{{ by_id[r].title if r in by_id else r }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
</header>
{% if doc.depends_on or used_by %}
<div class="dependency-strip">
{% if doc.depends_on %}<div><span class="relationship-label">Depends on</span>{% for id in doc.depends_on if id in by_id %}<a href="{{ by_id[id].out }}">{{ by_id[id].title }} <span aria-hidden="true">↗</span></a>{% endfor %}</div>{% endif %}
{% if used_by %}<div><span class="relationship-label">Used by</span>{% for other in used_by %}<a href="{{ other.out }}">{{ other.title }} <span aria-hidden="true">↗</span></a>{% endfor %}</div>{% endif %}
</div>
{% endif %}
<details class="mobile-outline"><summary>On this page</summary><nav aria-label="Page sections">
{% for s in doc.outline %}<a href="#{{ s.slug }}" class="{{ 'sub' if s.level > 2 }}">{{ s.title }}</a>{% endfor %}
</nav></details>
{% if warnings %}
<details class="build-notes"><summary>{{ warnings | length }} build note{{ 's' if warnings | length != 1 }} to review</summary>
  {% for w in warnings %}<p><span class="sev {{ severity.get(w.kind,'warn') }}">{{ severity.get(w.kind,'warn') }}</span> {{ w.message }}</p>{% endfor %}
</details>
{% endif %}
{% set children = docs | selectattr('parent', 'equalto', doc.id) | list %}
{% set maps = namespace(shown=false) %}
{{ doc.preamble | safe }}
{% for s in doc.outline %}
<section id="{{ s.slug }}" class="doc-section {{ 'anchored ' + s.kind if s.explicit else '' }} {{ 'tldr' if s.title | lower == 'tl;dr' }}">
  <h{{ s.level }}>{{ s.title }} <a class="heading-link" href="#{{ s.slug }}" aria-label="Link to {{ s.title }}">#</a></h{{ s.level }}>
  {{ s.body_html | safe }}
  {% if 'class="mermaid"' in s.body_html and doc.diagram_links %}
  <details class="diagram-destinations"><summary>Diagram destinations · {{ doc.diagram_links | length }}</summary>
  <nav aria-label="Diagram destinations">{% for node in doc.diagram_links if node in diagram_targets %}{% set target = diagram_targets[node] %}<a href="{{ target.href }}"><code>{{ node }}</code><span>{{ target.title }} ↗</span></a>{% endfor %}</nav>
  </details>
  {% endif %}
  {% if 'class="mermaid"' in s.body_html and children and not maps.shown %}
  {% set maps.shown=true %}
  <div class="component-grid" id="explore-next" aria-label="Components">{% for child in children %}
  <a class="component-card" href="{{ child.out }}"><span class="component-number">{{ '%02d' | format(loop.index) }} <span aria-hidden="true">↗</span></span><h3>{{ child.title }}</h3><p>{{ child.summary }}</p><div class="component-meta">{{ child.owns | length }} owned file{{ 's' if child.owns | length != 1 }} · {{ child.anchors | length }} stable anchor{{ 's' if child.anchors | length != 1 }}</div></a>
  {% endfor %}</div>
  {% endif %}
  {% set a = doc.anchors.get(s.id) %}
  {% if a and a.impls %}
  <div class="impls"><p class="evidence-label">Implementation <span>{{ a.impls | length }} linked declaration{{ 's' if a.impls | length != 1 }}</span></p>
    {% for t in a.impls %}
    <details class="impl"><summary>
      <span class="role {{ t.role }}">{{ t.role }}</span>
      <span class="sym">{{ t.symbol or (t.file | basename) }}</span>
      <span class="loc" title="{{ t.file }}">{{ t.file | basename }}:{{ t.line_start }}–{{ t.line_end }}</span>
    </summary>
    <div class="source-toolbar"><span>{{ t.file }}</span>{% set u = editor_url(t.file, t.line_start) %}{% if u %}<a href="{{ u }}">Open in editor ↗</a>{% endif %}</div>
    {% if t.note %}<p class="impl-note">{{ t.note }}</p>{% endif %}
    {% if t.code %}<pre><code class="language-{{ t.hljs }}">{{ t.code }}</code></pre>{% endif %}
    </details>
    {% endfor %}
  </div>
  {% endif %}
</section>
{% endfor %}
{% if doc.decisions %}
<h2>Decisions and change references</h2>
{% for decision in doc.decisions %}
<details class="impl"><summary>{{ decision.id }}</summary>
<p>{{ decision.reason }}</p>
{% for aid in decision.get('anchors', []) %}<p><code>{{ aid }}</code></p>{% endfor %}
{% for commit in decision.get('commits', []) %}<p>Commit: <code>{{ commit }}</code></p>{% endfor %}
{% for pr in decision.get('prs', []) %}<p><a href="{{ pr }}">{{ pr }}</a></p>{% endfor %}
</details>
{% endfor %}
{% endif %}

{% if children and not maps.shown %}
<section class="explore" id="explore-next">
<p class="eyebrow">Continue exploring</p><h2>Explore next</h2>
<div class="reading-links">{% for child in children %}
<a class="reading-link" href="{{ child.out }}"><div><h3>{{ child.title }}</h3><p>{{ child.summary }}</p></div><span aria-hidden="true">↗</span></a>
{% endfor %}</div>
</section>
{% endif %}

{% if doc.owns or doc.refs %}
<details class="source-references" id="sec-code"><summary>Source references <span>{{ doc.owns | length }} owned files · {{ doc.refs | length }} references</span></summary>
{% if doc.owns %}
<table>
  <tr><th>Owned file</th><th>Anchors here</th></tr>
  {% for f in doc.owns %}
  <tr><td>{% set u = editor_url(f, 1) %}{% if u %}<a href="{{ u }}"><code>{{ f }}</code> ↗</a>{% else %}<code>{{ f }}</code>{% endif %}</td>
      <td>{% for a in doc.anchors.values() %}{% for t in a.impls if t.file == f %}<a href="#{{ a.slug }}">{{ a.title }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% endfor %}</td></tr>
  {% endfor %}
</table>
{% endif %}
{% if doc.refs %}
<h3>Read-only references</h3>
<p class="crumb">Declarations referenced by this document.</p>
{% for r in doc.refs %}
<details class="impl">
  <summary>
    <span class="role">{{ 'ref' if r.resolved else 'broken' }}</span>
    <span class="sym">{{ r.symbol }}</span>
    <span class="loc">{{ r.file }}{% if r.resolved %}:{{ r.line_start }}–{{ r.line_end }}{% endif %}
      {% set u = editor_url(r.file, r.line_start) %}
      {% if r.resolved and u %}· <a href="{{ u }}">open</a>{% endif %}
    </span>
  </summary>
  {% if r.code %}<pre><code class="language-{{ r.hljs }}">{{ r.code }}</code></pre>{% endif %}
</details>
{% endfor %}
{% endif %}
</details>
{% endif %}
{% endblock %}

{% block scripts %}
{% set diagrams = namespace(present=false) %}
{% for section in doc.outline %}{% if 'class="mermaid"' in section.body_html %}{% set diagrams.present=true %}{% endif %}{% endfor %}
{% if diagrams.present %}
<script src="vendor/mermaid.min.js"></script>
<script id="diagram-targets" type="application/json">{{ diagram_targets | tojson }}</script>
<script src="diagrams.js" defer></script>
{% endif %}
{% endblock %}
