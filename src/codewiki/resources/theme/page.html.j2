{% extends "_base.html.j2" %}
{% block title %}{{ doc.title }} — {{ project.name }}{% endblock %}

{% block sidenav %}
<p class="eyebrow">{{ tr("On this page") }}</p>
<nav>
  {% for s in doc.outline %}
    <a href="#{{ s.slug }}" class="{{ 'sub' if s.level > 2 }}">{{ s.title }}</a>
  {% endfor %}
  {% if docs | selectattr('parent', 'equalto', doc.id) | list %}<a href="#explore-next">{{ tr("Explore next") }}</a>{% endif %}
  {% if doc.owns or doc.refs %}<a href="#sec-code">{{ tr("Source references") }}</a>{% endif %}
</nav>
<p class="toc-source">{{ tr("Page source") }}<br><code>{{ doc.path }}</code></p>
{% endblock %}

{% block main %}
<nav class="breadcrumb" aria-label="{{ tr('Breadcrumb') }}">
<a href="{{ page_url('index.html') }}">{{ project.name }}</a><span aria-hidden="true">/</span>
{% for ancestor in ancestors %}<a href="{{ ancestor.out }}">{{ ancestor.title }}</a><span aria-hidden="true">/</span>{% endfor %}
<span>{{ tr(doc.type | capitalize) }}</span>
</nav>
<header class="page-heading">
  {% set root = ancestors[0] if ancestors else doc %}
  {% if root.type == 'manual' %}
  <div class="reading-depth" aria-label="{{ tr('Reading path') }}"><a href="{{ root.out }}">{{ root.title }}</a>{% for ancestor in ancestors[1:] %}<span>→</span><a href="{{ ancestor.out }}">{{ ancestor.title }}</a>{% endfor %}{% if doc.parent %}<span>→</span><span class="active">{{ doc.title }}</span>{% endif %}</div>
  {% else %}
  <div class="reading-depth" aria-label="{{ tr('Reading path') }}"><a href="{{ ancestors[0].out if ancestors else doc.out }}">{{ tr("01 Architecture") }}</a><span>→</span><span class="{{ 'active' if doc.parent }}">{{ tr("02 Component") }}</span><span>→</span><span>{{ tr("03 Implementation") }}</span></div>
  {% endif %}
  <div class="eyebrow">{{ tr(doc.type | capitalize) }} {{ tr('guide') }} <span class="status st-{{ doc.status }}">{{ tr(doc.status) }}</span></div>
  <h1>{{ doc.title }}</h1>
  {% if doc.summary %}<p class="lead">{{ doc.summary }}</p>{% endif %}
  {% if doc.related %}<div class="related">{{ tr('Related:') }} {% for r in doc.related %}<a href="{{ page_url(r + '.html') }}">{{ by_id[r].title if r in by_id else r }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
</header>
{% if doc.depends_on or used_by %}
<div class="dependency-strip">
{% if doc.depends_on %}<div><span class="relationship-label">{{ tr("Depends on") }}</span>{% for id in doc.depends_on if id in by_id %}<a href="{{ by_id[id].out }}">{{ by_id[id].title }} <span aria-hidden="true">↗</span></a>{% endfor %}</div>{% endif %}
{% if used_by %}<div><span class="relationship-label">{{ tr("Used by") }}</span>{% for other in used_by %}<a href="{{ other.out }}">{{ other.title }} <span aria-hidden="true">↗</span></a>{% endfor %}</div>{% endif %}
</div>
{% endif %}
<details class="mobile-outline"><summary>{{ tr("On this page") }}</summary><nav aria-label="{{ tr('Page sections') }}">
{% for s in doc.outline %}<a href="#{{ s.slug }}" class="{{ 'sub' if s.level > 2 }}">{{ s.title }}</a>{% endfor %}
</nav></details>
{% if review %}
<details class="build-notes" {{ 'open' if review.state != 'current' }}>
  <summary>{{ tr('Documentation review') }}: {{ tr(review.state) }}</summary>
  <p>{{ tr(review.reason) }}. {{ tr('This status reflects the latest site build.') }}</p>
  {% if review.previous %}<p>{{ tr('Last review:') }} {{ review.previous.reviewed_at }} · {{ review.previous.outcome }} — {{ review.previous.reason }}</p>{% endif %}
  {% for change in review.changes if change.kind == 'source' %}<p>{{ tr('Source changed:') }} <code>{{ change.path }}</code></p>{% endfor %}
</details>
{% endif %}
{% if warnings %}
<details class="build-notes"><summary>{{ warnings | length }} {{ tr('build notes to review', warnings | length) }}</summary>
  {% for w in warnings %}<p><span class="sev {{ severity.get(w.kind,'warn') }}">{{ severity.get(w.kind,'warn') }}</span> {{ w.message }}</p>{% endfor %}
</details>
{% endif %}
{% set children = docs | selectattr('parent', 'equalto', doc.id) | list %}
{% set maps = namespace(shown=false) %}
{% if doc.translation_missing %}<p class="translation-notice">{{ tr('English fallback: this page has not been translated yet.') }}</p>{% endif %}
<div lang="{{ doc.content_language }}">
{{ doc.preamble | safe }}
{% for s in doc.outline %}
<section id="{{ s.slug }}" class="doc-section {{ 'anchored ' + s.kind if s.explicit else '' }} {{ 'tldr' if s.slug == 'tl-dr' }}">
  <h{{ s.level }}>{{ s.title }} <a class="heading-link" href="#{{ s.slug }}" aria-label="{{ tr('Link to') }} {{ s.title }}">#</a></h{{ s.level }}>
  {{ s.body_html | safe }}
  {% if 'class="mermaid"' in s.body_html and doc.diagram_links %}
  <details class="diagram-destinations"><summary>{{ tr('Diagram destinations') }} · {{ doc.diagram_links | length }}</summary>
  <nav aria-label="{{ tr('Diagram destinations') }}">{% for node in doc.diagram_links if node in diagram_targets %}{% set target = diagram_targets[node] %}<a href="{{ target.href }}"><code>{{ node }}</code><span>{{ target.title }} ↗</span></a>{% endfor %}</nav>
  </details>
  {% endif %}
  {% if 'class="mermaid"' in s.body_html and children and not maps.shown %}
  {% set maps.shown=true %}
  <div class="component-grid" id="explore-next" aria-label="{{ tr('Components') }}">{% for child in children %}
  <a class="component-card" href="{{ child.out }}"><span class="component-number">{{ '%02d' | format(loop.index) }} <span aria-hidden="true">↗</span></span><h3>{{ child.title }}</h3><p>{{ child.summary }}</p><div class="component-meta">{{ child.owns | length }} {{ tr('owned files', child.owns | length) }} · {{ child.anchors | length }} {{ tr('stable anchors', child.anchors | length) }}</div></a>
  {% endfor %}</div>
  {% endif %}
  {% set a = doc.anchors.get(s.id) %}
  {% if a and a.impls %}
  <div class="impls"><p class="evidence-label">{{ tr('Implementation') }} <span>{{ a.impls | length }} {{ tr('linked declarations', a.impls | length) }}</span></p>
    {% for t in a.impls %}
    <details class="impl"><summary>
      <span class="role {{ t.role }}">{{ t.role }}</span>
      <span class="sym">{{ t.symbol or (t.file | basename) }}</span>
      <span class="loc" title="{{ t.file }}">{{ t.file | basename }}:{{ t.line_start }}–{{ t.line_end }}</span>
    </summary>
    <div class="source-toolbar"><span>{{ t.file }}</span>{% set u = editor_url(t.file, t.line_start) %}{% if u %}<a href="{{ u }}">{{ tr("Open in editor \u2197") }}</a>{% endif %}</div>
    {% if t.note %}<p class="impl-note">{{ t.note }}</p>{% endif %}
    {% if t.code %}<pre><code class="language-{{ t.hljs }}">{{ t.code }}</code></pre>{% endif %}
    </details>
    {% endfor %}
  </div>
  {% endif %}
</section>
{% endfor %}
</div>
{% if doc.decisions %}
<h2>{{ tr("Decisions and change references") }}</h2>
{% for decision in doc.decisions %}
<details class="impl"><summary>{{ decision.id }}</summary>
<p>{{ decision.reason }}</p>
{% for aid in decision.get('anchors', []) %}<p><code>{{ aid }}</code></p>{% endfor %}
{% for commit in decision.get('commits', []) %}<p>Commit: <code>{{ commit }}</code></p>{% endfor %}
{% for pr in decision.get('prs', []) %}<p><a href="{{ pr }}">{{ pr }}</a></p>{% endfor %}
</details>
{% endfor %}
{% endif %}

{% if children and not maps.shown %}
<section class="explore" id="explore-next">
<p class="eyebrow">{{ tr("Continue exploring") }}</p><h2>{{ tr("Explore next") }}</h2>
<div class="reading-links">{% for child in children %}
<a class="reading-link" href="{{ child.out }}"><div><h3>{{ child.title }}</h3><p>{{ child.summary }}</p></div><span aria-hidden="true">↗</span></a>
{% endfor %}</div>
</section>
{% endif %}

{% if doc.owns or doc.refs %}
<details class="source-references" id="sec-code"><summary>{{ tr('Source references') }} <span>{{ doc.owns | length }} {{ tr('owned files') }} · {{ doc.refs | length }} {{ tr('references') }}</span></summary>
{% if doc.owns %}
<table>
  <tr><th>{{ tr("Owned file") }}</th><th>{{ tr("Anchors here") }}</th></tr>
  {% for f in doc.owns %}
  <tr><td>{% set u = editor_url(f, 1) %}{% if u %}<a href="{{ u }}"><code>{{ f }}</code> ↗</a>{% else %}<code>{{ f }}</code>{% endif %}</td>
      <td>{% for a in doc.anchors.values() %}{% for t in a.impls if t.file == f %}<a href="#{{ a.slug }}">{{ a.title }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% endfor %}</td></tr>
  {% endfor %}
</table>
{% endif %}
{% if doc.refs %}
<h3>{{ tr("Read-only references") }}</h3>
<p class="crumb">{{ tr("Declarations referenced by this document.") }}</p>
{% for r in doc.refs %}
<details class="impl">
  <summary>
    <span class="role">{{ 'ref' if r.resolved else 'broken' }}</span>
    <span class="sym">{{ r.symbol }}</span>
    <span class="loc">{{ r.file }}{% if r.resolved %}:{{ r.line_start }}–{{ r.line_end }}{% endif %}
      {% set u = editor_url(r.file, r.line_start) %}
      {% if r.resolved and u %}· <a href="{{ u }}">{{ tr("open") }}</a>{% endif %}
    </span>
  </summary>
  {% if r.code %}<pre><code class="language-{{ r.hljs }}">{{ r.code }}</code></pre>{% endif %}
</details>
{% endfor %}
{% endif %}
</details>
{% endif %}
{% endblock %}

{% block scripts %}
{% set diagrams = namespace(present=false) %}
{% for section in doc.outline %}{% if 'class="mermaid"' in section.body_html %}{% set diagrams.present=true %}{% endif %}{% endfor %}
{% if diagrams.present %}
<script src="vendor/mermaid.min.js"></script>
<script id="diagram-targets" type="application/json">{{ diagram_targets | tojson }}</script>
<script src="diagrams.js" defer></script>
{% endif %}
{% endblock %}
